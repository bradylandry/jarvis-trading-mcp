# ---- Backend token (choose ONE source) ----
# Local dev: prefer run-local.sh (pulls from Keychain). Or set here for quick tests:
JARVIS_TRADING_TOKEN=
# Azure: pull from Key Vault via Managed Identity instead of a plaintext token:
# KEY_VAULT_URL=https://kv-jarvis-lab2.vault.azure.net/
# JARVIS_TOKEN_SECRET_NAME=jarvis-trading-token

# ---- Backend + limits ----
JARVIS_TRADING_API=https://trading.landrycmd.com
JARVIS_TRADING_MAX_CALLS_PER_MIN=30

# ---- User auth (deployed only; landrycmd tenant) ----
# AUTH_CLIENT_ID=
# AUTH_CLIENT_SECRET=
# AUTH_TENANT_ID=
# PUBLIC_BASE_URL=https://<app>.<suffix>.azurecontainerapps.io
